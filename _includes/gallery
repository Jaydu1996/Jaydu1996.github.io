{% include base_path %}

{% comment %}
获取图库数据源：优先读取传入id对应的页面字段，无id则读取 page.gallery
{% endcomment %}
{% if include.id %}
  {% assign gallery = page[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

{% comment %}
根据图片数量自动分配布局样式
{% endcomment %}
{% if gallery.size == 2 %}
  {% assign gallery_layout = "half" %}
{% elsif gallery.size >= 3 %}
  {% assign gallery_layout = "third" %}
{% else %}
  {% assign gallery_layout = "" %}
{% endif %}

<figure class="{{ gallery_layout }} {{ include.class }}">
  {% for img in gallery %}
    {% comment %}
    存在url字段：包裹<a>可点击跳转；无url仅展示图片
    {% endcomment %}
    {% if img.url %}
      <a href="{% if img.url contains '://' %}{{ img.url }}{% else %}{{ img.url | prepend: base_path }}{% endif %}"
        {% if img.title %}title="{{ img.title }}"{% endif %}>
        <img src="{% if img.image_path contains '://' %}{{ img.image_path }}{% else %}{{ img.image_path | prepend: "/images/" | prepend: base_path }}{% endif %}"
             alt="{% if img.alt %}{{ img.alt }}{% endif %}">
      </a>
    {% else %}
      <img src="{% if img.image_path contains '://' %}{{ img.image_path }}{% else %}{{ img.image_path | prepend: "/images/" | prepend: base_path }}{% endif %}"
           alt="{% if img.alt %}{{ img.alt }}{% endif %}">
    {% endif %}
  {% endfor %}

  {% comment %}底部图注，清理多余p标签{% endcomment %}
  {% if include.caption %}
    <figcaption>
      {{ include.caption | markdownify | remove: "<p>" | remove: "</p>" | trim }}
    </figcaption>
  {% endif %}
</figure>
